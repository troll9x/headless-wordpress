# Địa chỉ công khai, được phép đưa vào bundle trình duyệt
NEXT_PUBLIC_WP_BASE_URL=https://cms.tlu.edu.vn
# Origin serving this Next.js frontend (not the WordPress CMS origin).
# Replace with the real production/staging hostname before building.
NEXT_PUBLIC_SITE_URL=https://frontend.example.edu.vn
NEXT_PUBLIC_SITE_NAME=Trường Đại học Thủy lợi

# Cấu hình chỉ dùng phía server
WP_API_URL=https://cms.tlu.edu.vn/index.php?rest_route=/wp/v2
WP_SITE_URL=https://cms.tlu.edu.vn
LEGACY_WP_SITE_URL=https://tlu.edu.vn

# Viettel AI Text-to-Speech — không điền token thật vào file mẫu này
VIETTEL_TTS_API_URL=https://viettelai.vn/tts/speech_synthesis
VIETTEL_TTS_TOKEN=
VIETTEL_TTS_VOICE=hn-quynhanh
VIETTEL_TTS_SPEED=1
VIETTEL_TTS_WITHOUT_FILTER=false
TTS_RATE_LIMIT_MAX=30
TTS_RATE_LIMIT_WINDOW_SECONDS=60
# Only when Nginx overwrites X-Real-IP and Node port is private:
TRUSTED_CLIENT_IP_HEADER=
# Same 32+ character value as TLU_HEADLESS_SEARCH_PROXY_SECRET in WordPress:
SEARCH_PROXY_SECRET=

# Webhook WordPress -> Next.js. Generate at least 32 random bytes for production.
REVALIDATION_SECRET=
REVALIDATION_TIMESTAMP_TOLERANCE_SECONDS=300
REVALIDATION_MAX_BODY_BYTES=262144
